#!/bin/bash
# DFS Management Script

# Ensure we are in the project directory
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$SCRIPT_DIR"

# Check if mvn is installed
if ! command -v mvn &> /dev/null
then
    echo "Error: maven (mvn) is not installed."
    exit 1
fi

if [[ "$1" == "init" ]]; then
    # Run the setup tool
    mvn -q -Dexec.mainClass=org.example.setup.SetupTool exec:java
    exit $?
fi

# Run the management tool via Maven
mvn javafx:run

